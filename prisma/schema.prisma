generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

enum RoleType {
  BUYER
  FARMER
  STORE_OPERATOR
  HUB_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BuyerBusinessType {
  INDIVIDUAL
  RETAILER
  WHOLESALER
  PROCESSOR
  OTHER
}

enum AddressLabel {
  FARM
  SHOP
  HOME
  WAREHOUSE
  OTHER
}

enum OtpChannelType {
  EMAIL
  SMS
  IN_APP
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PIN
  VERIFY_EMAIL
  VERIFY_PHONE
  CASH_HANDOVER
}

enum QuantityUnit {
  KG
  QUINTAL
  CRATE
  BAG
  PIECE
  DOZEN
}

enum QualityGrade {
  GRADE_A
  GRADE_B
  GRADE_C
  EXPORT
  ORGANIC
}

enum PerishabilityType {
  PERISHABLE
  NON_PERISHABLE
}

enum RateTrend {
  UP
  DOWN
  STABLE
}

enum MandiRateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VehicleType {
  TRACTOR_TROLLEY
  TEMPO
  TRUCK
  PICKUP
  OTHER
}

enum ProduceListingStatus {
  DRAFT
  SUBMITTED
  TOKEN_GENERATED
  CANCELLED
  COMPLETED
}

enum SupplyTokenStatus {
  BOOKED
  ARRIVED
  WEIGHED
  GRN_ISSUED
  CANCELLED
  EXPIRED
}

enum GrnPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum InventoryTransactionType {
  GRN_IN
  ORDER_RESERVE
  ORDER_DISPATCH
  ORDER_CANCEL_RELEASE
  RETURN_RESTOCK
  RETURN_SPOILAGE
  ADJUSTMENT
}

enum FulfillmentType {
  SELF_PICKUP
  KTC_DELIVERY
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH
  MANUAL_UPI
  BANK_TRANSFER
  GATEWAY
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  REFUNDED
}

enum ReturnCondition {
  RESTOCKABLE
  DAMAGED_SPOILED
}

enum ChargeDirection {
  ADDITION
  DEDUCTION
}

enum ChargeCalculationType {
  FLAT
  PERCENTAGE
  PER_UNIT_WEIGHT
}

enum ChargeVisibility {
  HIDDEN
  PUBLIC
}

enum ChargeStage {
  INBOUND_GRN
  CATALOG_PRICE
  OUTBOUND_ORDER
}

enum CashAccountType {
  OPERATOR_CASH_IN_HAND
  DELIVERY_AGENT_CASH
  HUB_SAFE
  ADMIN_TREASURY
  BANK_DEPOSIT
  FARMER_PAYABLE
  BUYER_RECEIVABLE
}

enum CashTransferStatus {
  INITIATED
  CONFIRMED
  DISPUTED
  CANCELLED
}

enum CashReferenceType {
  ORDER_PAYMENT
  FARMER_PAYOUT
  SAFE_DEPOSIT
  TREASURY_TRANSFER
  BANK_DEPOSIT
  ORDER_REFUND
}

enum PayoutType {
  FIFO_SETTLEMENT
  MANUAL_ADVANCE
  MANUAL_OVERRIDE
}

enum PayoutStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum DocumentType {
  AADHAAR
  PAN
  GSTIN
  STAFF_ID
  OTHER
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  HANDOVER_OTP
  ORDER_UPDATE
  TOKEN_UPDATE
  PAYOUT_UPDATE
  PRICE_ALERT
  GENERAL
}

enum DisputeCategory {
  CASH_HANDOVER
  GRN_WEIGHT_QUALITY
  ORDER_DELIVERY
  GENERAL_QUERY
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

enum HubOnboardingStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

enum FranchiseEntityType {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
}

enum FranchiseModel {
  FOFO
  FOCO
}

enum HubDocumentType {
  PAN_CARD
  AADHAAR_CARD
  OWNER_PHOTO
  FSSAI_LICENSE
  SHOP_ESTABLISHMENT
  PREMISES_PROOF
  SHOP_EXTERIOR_PHOTO
  SHOP_INTERIOR_PHOTO
  CANCELLED_CHEQUE
  FRANCHISE_AGREEMENT
  GST_CERTIFICATE
  WEIGHING_SCALE_CERT
  APMC_LICENSE
  SECURITY_DEPOSIT_RECEIPT
}

enum DocumentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String     @id @default(uuid())
  email             String?
  emailVerifiedAt   DateTime?
  phone             String?
  phoneVerifiedAt   DateTime?
  pinHash           String?
  failedPinAttempts Int        @default(0)
  pinLockedUntil    DateTime?
  name              String?
  languagePref      String     @default("en")
  status            UserStatus @default(ACTIVE)
  metadata          Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles              UserRole[]
  sessions           UserSession[]
  farmerProfile      FarmerProfile?
  buyerProfile       BuyerProfile?
  bankAccounts       BankAccount[]
  addresses          Address[]
  staffAssignments   HubStaffAssignment[]
  produceListings    ProduceListing[]
  supplyTokens       SupplyToken[]
  goodsReceiptNotes  GoodsReceiptNote[]
  operatedGrns       GoodsReceiptNote[]   @relation("GrnOperator")
  orders             Order[]
  inspectedReturns   OrderReturn[]        @relation("ReturnInspector")
  addedCharges       TransactionCharge[]  @relation("ChargeAddedBy")
  cashAccounts       CashAccount[]        @relation("CashAccountOwner")
  initiatedTransfers CashTransfer[]       @relation("TransferInitiator")
  confirmedTransfers CashTransfer[]       @relation("TransferConfirmer")
  approvedPayouts    FarmerPayout[]       @relation("PayoutApprover")
  farmerPayouts      FarmerPayout[]       @relation("FarmerPayoutRecipient")
  cart               Cart?
  documents          UserDocument[]       @relation("UserDocuments")
  verifiedDocuments  UserDocument[]       @relation("DocumentVerifier")
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]           @relation("AuditActor")
  disputesRaised     Dispute[]            @relation("DisputeRaiser")
  disputesResolved   Dispute[]            @relation("DisputeResolver")
  operatedLedgers    InventoryLedger[]    @relation("LedgerOperator")

  @@index([email])
  @@index([phone])
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  activeRole       RoleType
  deviceInfo       Json?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([refreshTokenHash])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleType
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model FarmerProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  fatherName    String?
  village       String?
  tehsilOrBlock String?
  district      String?
  state         String?
  pinCode       String?
  landAreaAcres Decimal?  @db.Decimal(8, 2)
  kycStatus     KycStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  businessName String?
  businessType BuyerBusinessType @default(INDIVIDUAL)
  gstin        String?
  panNumber    String?
  kycStatus    KycStatus         @default(PENDING)
  metadata     Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String?
  branchName        String?
  isVerified        Boolean  @default(false)
  isDefault         Boolean  @default(false)
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts FarmerPayout[]

  @@index([userId])
}

model Address {
  id            String                                 @id @default(uuid())
  userId        String
  label         AddressLabel                           @default(HOME)
  isDefault     Boolean                                @default(false)
  contactName   String
  contactPhone  String
  addressLine1  String
  addressLine2  String?
  landmark      String?
  tehsilOrBlock String?
  cityOrTown    String
  district      String
  state         String
  pinCode       String
  country       String                                 @default("IN")
  latitude      Decimal?                               @db.Decimal(10, 7)
  longitude     Decimal?                               @db.Decimal(10, 7)
  location      Unsupported("geography(Point, 4326)")?
  metadata      Json?
  createdAt     DateTime                               @default(now())
  updatedAt     DateTime                               @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  produceListings ProduceListing[]

  @@index([userId])
  @@index([location], type: Gist)
}

model OtpVerification {
  id          String         @id @default(uuid())
  identifier  String
  channel     OtpChannelType
  purpose     OtpPurpose
  otpHash     String
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  isUsed      Boolean        @default(false)
  metadata    Json?
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([identifier, purpose, isUsed])
}

model KtsHub {
  id               String                                 @id @default(uuid())
  code             String                                 @unique
  name             String
  translations     Json
  addressLine      String
  cityOrTown       String
  district         String
  state            String
  pinCode          String
  contactPhone     String?
  operatingHours   String?
  isActive         Boolean                                @default(true)
  onboardingStatus HubOnboardingStatus                    @default(PENDING_VERIFICATION)
  latitude         Decimal                                @db.Decimal(10, 7)
  longitude        Decimal                                @db.Decimal(10, 7)
  location         Unsupported("geography(Point, 4326)")?
  metadata         Json?
  createdAt        DateTime                               @default(now())
  updatedAt        DateTime                               @updatedAt

  franchiseProfile  HubFranchiseProfile?
  documents         HubDocument[]
  staffAssignments  HubStaffAssignment[]
  inventories       HubInventory[]
  inventoryLedgers  InventoryLedger[]
  mandiRates        MandiRate[]
  supplyTokens      SupplyToken[]
  goodsReceiptNotes GoodsReceiptNote[]
  orders            Order[]
  preBookBatches    PreBookBatch[]
  cashAccounts      CashAccount[]
  cartItems         CartItem[]

  @@index([location], type: Gist)
}

model HubFranchiseProfile {
  id                    String              @id @default(uuid())
  hubId                 String              @unique
  entityType            FranchiseEntityType
  ownerName             String
  ownerPhone            String
  ownerEmail            String?
  panNumber             String?
  gstin                 String?
  fssaiNumber           String?
  bankAccountHolder     String?
  bankAccountNumber     String?
  bankIfsc              String?
  bankName              String?
  franchiseModel        FranchiseModel      @default(FOFO)
  commissionPercent     Decimal?            @db.Decimal(5, 2)
  securityDepositAmount Decimal?            @db.Decimal(12, 2)
  maxCashLimit          Decimal?            @db.Decimal(12, 2)
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  hub KtsHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
}

model HubDocument {
  id                 String                     @id @default(uuid())
  hubId              String
  documentType       HubDocumentType
  bucketType         String
  storageKey         String
  fileName           String
  mimeType           String
  documentNumber     String?
  expiryDate         DateTime?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  rejectionReason    String?
  verifiedById       String?
  verifiedAt         DateTime?
  metadata           Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  hub KtsHub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId, documentType])
}

model HubStaffAssignment {
  id        String   @id @default(uuid())
  hubId     String
  userId    String
  role      RoleType
  isActive  Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hub  KtsHub @relation(fields: [hubId], references: [id], onDelete: Cascade)
  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hubId, userId, role])
  @@index([userId])
}

model Category {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  translations Json
  icon         String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crops Crop[]
}

model Crop {
  id                        String            @id @default(uuid())
  categoryId                String
  slug                      String            @unique
  name                      String
  translations              Json
  botanicalName             String?
  perishabilityType         PerishabilityType @default(NON_PERISHABLE)
  shelfLifeDays             Int?
  baseUnit                  QuantityUnit      @default(KG)
  unitConversions           Json?
  standardMoistureThreshold Decimal?          @db.Decimal(5, 2)
  imageUrl                  String?
  isActive                  Boolean           @default(true)
  metadata                  Json?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  category  Category      @relation(fields: [categoryId], references: [id])
  varieties CropVariety[]

  @@index([categoryId])
  @@index([perishabilityType])
}

model CropVariety {
  id              String   @id @default(uuid())
  cropId          String
  slug            String   @unique
  name            String
  translations    Json
  unitConversions Json?
  gradeSpecs      Json?
  imageUrl        String?
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  crop              Crop               @relation(fields: [cropId], references: [id])
  mandiRates        MandiRate[]
  produceListings   ProduceListing[]
  supplyTokens      SupplyToken[]
  goodsReceiptNotes GoodsReceiptNote[]
  hubInventories    HubInventory[]
  inventoryLedgers  InventoryLedger[]
  orderItems        OrderItem[]
  preBookBatches    PreBookBatch[]
  cartItems         CartItem[]

  @@index([cropId])
}

model MandiRate {
  id                  String          @id @default(uuid())
  hubId               String?
  cropVarietyId       String
  grade               QualityGrade?   @default(GRADE_A)
  gradeCode           String          @default("GRADE_A")
  rateDate            DateTime        @db.Date
  minRatePerUnit      Decimal         @db.Decimal(12, 2)
  maxRatePerUnit      Decimal         @db.Decimal(12, 2)
  baseRatePerUnit     Decimal         @db.Decimal(12, 2)
  farmerBuyRate       Decimal         @default(0) @db.Decimal(12, 2)
  consumerSellRate    Decimal         @default(0) @db.Decimal(12, 2)
  marginPercent       Decimal         @default(0) @db.Decimal(6, 2)
  bulkTiers           Json?
  unit                QuantityUnit    @default(QUINTAL)
  trend               RateTrend       @default(STABLE)
  apmcDelta           Decimal?        @db.Decimal(10, 2)
  status              MandiRateStatus @default(DRAFT)
  isProcurementActive Boolean         @default(true)
  notes               String?
  createdById         String?
  updatedById         String?
  publishedById       String?
  publishedAt         DateTime?
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  hub         KtsHub?     @relation(fields: [hubId], references: [id])
  cropVariety CropVariety @relation(fields: [cropVarietyId], references: [id])

  @@index([hubId, cropVarietyId, gradeCode, rateDate])
  @@index([cropVarietyId, rateDate])
  @@index([status, rateDate])
}

model ProduceListing {
  id                String               @id @default(uuid())
  farmerId          String
  cropVarietyId     String
  grade             QualityGrade         @default(GRADE_A)
  estimatedQuantity Decimal              @db.Decimal(12, 2)
  unit              QuantityUnit         @default(QUINTAL)
  estimatedMoisture Decimal?             @db.Decimal(5, 2)
  farmAddressId     String?
  photos            String[]
  status            ProduceListingStatus @default(DRAFT)
  notes             String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  farmer       User          @relation(fields: [farmerId], references: [id])
  cropVariety  CropVariety   @relation(fields: [cropVarietyId], references: [id])
  farmAddress  Address?      @relation(fields: [farmAddressId], references: [id])
  supplyTokens SupplyToken[]

  @@index([farmerId])
}

model SupplyToken {
  id                String            @id @default(uuid())
  tokenNumber       String            @unique
  farmerId          String
  produceListingId  String?
  hubId             String
  cropVarietyId     String
  grade             QualityGrade      @default(GRADE_A)
  slotDate          DateTime          @db.Date
  slotStartTime     String
  slotEndTime       String
  estimatedQuantity Decimal           @db.Decimal(12, 2)
  unit              QuantityUnit      @default(QUINTAL)
  lockedRatePerUnit Decimal           @db.Decimal(12, 2)
  estimatedPayout   Decimal           @db.Decimal(14, 2)
  vehicleType       VehicleType       @default(TRACTOR_TROLLEY)
  vehicleNumber     String?
  qrPayload         String            @unique
  status            SupplyTokenStatus @default(BOOKED)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  farmer           User                @relation(fields: [farmerId], references: [id])
  produceListing   ProduceListing?     @relation(fields: [produceListingId], references: [id])
  hub              KtsHub              @relation(fields: [hubId], references: [id])
  cropVariety      CropVariety         @relation(fields: [cropVarietyId], references: [id])
  goodsReceiptNote GoodsReceiptNote?
  charges          TransactionCharge[]

  @@index([farmerId])
  @@index([hubId, slotDate])
}

model GoodsReceiptNote {
  id                           String           @id @default(uuid())
  grnNumber                    String           @unique
  supplyTokenId                String           @unique
  hubId                        String
  farmerId                     String
  cropVarietyId                String
  assignedGrade                QualityGrade
  grossWeight                  Decimal          @db.Decimal(12, 2)
  tareWeight                   Decimal          @db.Decimal(12, 2)
  netWeight                    Decimal          @db.Decimal(12, 2)
  measuredMoisture             Decimal?         @db.Decimal(5, 2)
  moistureDeductionWeight      Decimal          @default(0) @db.Decimal(12, 2)
  foreignMatterDeductionWeight Decimal          @default(0) @db.Decimal(12, 2)
  netBillableWeight            Decimal          @db.Decimal(12, 2)
  weightUnit                   QuantityUnit     @default(KG)
  displayUnit                  QuantityUnit?
  displayQuantity              Decimal?         @db.Decimal(12, 2)
  appliedRatePerUnit           Decimal          @db.Decimal(12, 2)
  grossAmount                  Decimal          @db.Decimal(14, 2)
  deductionAmount              Decimal          @default(0) @db.Decimal(14, 2)
  netPayableAmount             Decimal          @db.Decimal(14, 2)
  fifoAllocatedWeight          Decimal          @default(0) @db.Decimal(12, 2)
  totalPaidAmount              Decimal          @default(0) @db.Decimal(14, 2)
  paymentStatus                GrnPaymentStatus @default(UNPAID)
  operatorUserId               String
  issuedAt                     DateTime         @default(now())
  metadata                     Json?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  supplyToken        SupplyToken         @relation(fields: [supplyTokenId], references: [id])
  hub                KtsHub              @relation(fields: [hubId], references: [id])
  farmer             User                @relation(fields: [farmerId], references: [id])
  cropVariety        CropVariety         @relation(fields: [cropVarietyId], references: [id])
  operator           User                @relation("GrnOperator", fields: [operatorUserId], references: [id])
  transactionCharges TransactionCharge[]
  farmerPayouts      FarmerPayout[]
  inventoryLedgers   InventoryLedger[]
  disputes           Dispute[]

  @@index([farmerId])
  @@index([hubId, issuedAt])
}

model HubInventory {
  id                      String       @id @default(uuid())
  hubId                   String
  cropVarietyId           String
  grade                   QualityGrade
  unit                    QuantityUnit @default(KG)
  availableQty            Decimal      @default(0) @db.Decimal(14, 2)
  reservedQty             Decimal      @default(0) @db.Decimal(14, 2)
  baseSellingPricePerUnit Decimal      @db.Decimal(12, 2)
  metadata                Json?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  hub         KtsHub      @relation(fields: [hubId], references: [id])
  cropVariety CropVariety @relation(fields: [cropVarietyId], references: [id])

  @@unique([hubId, cropVarietyId, grade])
  @@index([cropVarietyId, grade])
}

model InventoryLedger {
  id              String                   @id @default(uuid())
  hubId           String
  cropVarietyId   String
  grade           QualityGrade
  transactionType InventoryTransactionType
  quantity        Decimal                  @db.Decimal(14, 2)
  unit            QuantityUnit             @default(KG)
  balanceAfter    Decimal                  @db.Decimal(14, 2)
  grnId           String?
  orderId         String?
  orderReturnId   String?
  operatorUserId  String?
  notes           String?
  metadata        Json?
  createdAt       DateTime                 @default(now())

  hub         KtsHub            @relation(fields: [hubId], references: [id])
  cropVariety CropVariety       @relation(fields: [cropVarietyId], references: [id])
  grn         GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  order       Order?            @relation(fields: [orderId], references: [id])
  orderReturn OrderReturn?      @relation(fields: [orderReturnId], references: [id])
  operator    User?             @relation("LedgerOperator", fields: [operatorUserId], references: [id])

  @@index([hubId, cropVarietyId, grade])
  @@index([grnId])
  @@index([orderId])
}

model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  buyerId           String
  hubId             String
  status            OrderStatus     @default(PLACED)
  fulfillmentType   FulfillmentType @default(KTC_DELIVERY)
  deliveryAddressId String?
  subtotalAmount    Decimal         @db.Decimal(14, 2)
  chargesAmount     Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal         @db.Decimal(14, 2)
  paymentMethod     PaymentMethod   @default(CASH)
  paymentStatus     PaymentStatus   @default(PENDING)
  cancelReason      String?
  cancelledAt       DateTime?
  deliveredAt       DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  buyer            User                @relation(fields: [buyerId], references: [id])
  hub              KtsHub              @relation(fields: [hubId], references: [id])
  deliveryAddress  Address?            @relation(fields: [deliveryAddressId], references: [id])
  items            OrderItem[]
  charges          TransactionCharge[]
  returns          OrderReturn[]
  cashTransfers    CashTransfer[]
  inventoryLedgers InventoryLedger[]
  disputes         Dispute[]

  @@index([buyerId])
  @@index([hubId, status])
}

model OrderItem {
  id             String       @id @default(uuid())
  orderId        String
  cropVarietyId  String
  preBookBatchId String?
  grade          QualityGrade
  quantity       Decimal      @db.Decimal(12, 2)
  unit           QuantityUnit
  unitPrice      Decimal      @db.Decimal(12, 2)
  subtotal       Decimal      @db.Decimal(14, 2)
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cropVariety  CropVariety         @relation(fields: [cropVarietyId], references: [id])
  preBookBatch PreBookBatch?       @relation(fields: [preBookBatchId], references: [id])
  charges      TransactionCharge[]
  returns      OrderReturn[]

  @@index([orderId])
  @@index([preBookBatchId])
}

model PreBookBatch {
  id                 String       @id @default(uuid())
  cropVarietyId      String
  hubId              String?
  targetPricePerUnit Decimal      @db.Decimal(12, 2)
  unit               QuantityUnit @default(KG)
  batchDate          DateTime     @db.Date
  description        String?
  discountPercent    Decimal?     @db.Decimal(5, 2)
  maxQuantity        Decimal?     @db.Decimal(14, 2)
  bookedQuantity     Decimal      @default(0) @db.Decimal(14, 2)
  isActive           Boolean      @default(true)
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  cropVariety CropVariety @relation(fields: [cropVarietyId], references: [id])
  hub         KtsHub?     @relation(fields: [hubId], references: [id])
  orderItems  OrderItem[]
}

model OrderReturn {
  id                String          @id @default(uuid())
  orderId           String
  orderItemId       String
  quantity          Decimal         @db.Decimal(12, 2)
  unit              QuantityUnit
  reason            String
  condition         ReturnCondition
  inspectedByUserId String
  notes             String?
  metadata          Json?
  createdAt         DateTime        @default(now())

  order            Order             @relation(fields: [orderId], references: [id])
  orderItem        OrderItem         @relation(fields: [orderItemId], references: [id])
  inspector        User              @relation("ReturnInspector", fields: [inspectedByUserId], references: [id])
  inventoryLedgers InventoryLedger[]

  @@index([orderId])
}

model ChargeDefinition {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  translations    Json
  direction       ChargeDirection
  calculationType ChargeCalculationType
  visibility      ChargeVisibility
  stage           ChargeStage
  allowedRoles    RoleType[]
  defaultRate     Decimal               @db.Decimal(10, 4)
  isActive        Boolean               @default(true)
  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  transactionCharges TransactionCharge[]
}

model TransactionCharge {
  id                 String                @id @default(uuid())
  chargeDefinitionId String
  supplyTokenId      String?
  grnId              String?
  orderId            String?
  orderItemId        String?
  nameSnapshot       String
  direction          ChargeDirection
  visibility         ChargeVisibility
  calculationType    ChargeCalculationType
  rateApplied        Decimal               @db.Decimal(10, 4)
  calculatedAmount   Decimal               @db.Decimal(14, 2)
  addedByUserId      String?
  addedByRole        RoleType?
  metadata           Json?
  createdAt          DateTime              @default(now())

  chargeDefinition ChargeDefinition  @relation(fields: [chargeDefinitionId], references: [id])
  supplyToken      SupplyToken?      @relation(fields: [supplyTokenId], references: [id])
  grn              GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  orderItem        OrderItem?        @relation(fields: [orderItemId], references: [id])
  addedBy          User?             @relation("ChargeAddedBy", fields: [addedByUserId], references: [id])

  @@index([supplyTokenId])
  @@index([grnId])
  @@index([orderId])
  @@index([orderItemId])
}

model CashAccount {
  id          String          @id @default(uuid())
  type        CashAccountType
  ownerUserId String?
  hubId       String?
  balance     Decimal         @default(0) @db.Decimal(14, 2)
  currency    String          @default("INR")
  isActive    Boolean         @default(true)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner         User?          @relation("CashAccountOwner", fields: [ownerUserId], references: [id])
  hub           KtsHub?        @relation(fields: [hubId], references: [id])
  transfersFrom CashTransfer[] @relation("FromAccount")
  transfersTo   CashTransfer[] @relation("ToAccount")

  @@index([ownerUserId])
  @@index([hubId, type])
}

model CashTransfer {
  id                String             @id @default(uuid())
  transferNumber    String             @unique
  fromAccountId     String
  toAccountId       String
  amount            Decimal            @db.Decimal(14, 2)
  status            CashTransferStatus @default(INITIATED)
  handoverOtpHash   String?
  referenceType     CashReferenceType?
  referenceId       String?
  orderId           String?
  payoutId          String?
  initiatedByUserId String
  confirmedByUserId String?
  confirmedAt       DateTime?
  notes             String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  fromAccount CashAccount   @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   CashAccount   @relation("ToAccount", fields: [toAccountId], references: [id])
  initiatedBy User          @relation("TransferInitiator", fields: [initiatedByUserId], references: [id])
  confirmedBy User?         @relation("TransferConfirmer", fields: [confirmedByUserId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
  payout      FarmerPayout? @relation(fields: [payoutId], references: [id])
  disputes    Dispute[]

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([orderId])
  @@index([payoutId])
}

model FarmerPayout {
  id                  String        @id @default(uuid())
  payoutNumber        String        @unique
  farmerId            String
  grnId               String
  bankAccountId       String?
  amount              Decimal       @db.Decimal(14, 2)
  allocatedWeight     Decimal?      @db.Decimal(12, 2)
  payoutType          PayoutType
  status              PayoutStatus  @default(INITIATED)
  paymentMethod       PaymentMethod @default(CASH)
  utrOrTransactionRef String?
  approvedByUserId    String?
  notes               String?
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  farmer        User             @relation("FarmerPayoutRecipient", fields: [farmerId], references: [id])
  grn           GoodsReceiptNote @relation(fields: [grnId], references: [id])
  bankAccount   BankAccount?     @relation(fields: [bankAccountId], references: [id])
  approvedBy    User?            @relation("PayoutApprover", fields: [approvedByUserId], references: [id])
  cashTransfers CashTransfer[]

  @@index([farmerId])
  @@index([grnId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id            String       @id @default(uuid())
  cartId        String
  hubId         String
  cropVarietyId String
  grade         QualityGrade
  quantity      Decimal      @db.Decimal(12, 2)
  unit          QuantityUnit
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cart        Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  hub         KtsHub      @relation(fields: [hubId], references: [id])
  cropVariety CropVariety @relation(fields: [cropVarietyId], references: [id])

  @@unique([cartId, hubId, cropVarietyId, grade])
  @@index([cartId])
}

model UserDocument {
  id               String       @id @default(uuid())
  userId           String
  docType          DocumentType
  docNumber        String?
  r2PrivateKey     String
  status           KycStatus    @default(PENDING)
  verifiedByUserId String?
  verifiedAt       DateTime?
  rejectionReason  String?
  providerMetadata Json?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user       User  @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("DocumentVerifier", fields: [verifiedByUserId], references: [id])

  @@index([userId, docType])
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  token     String         @unique
  platform  DevicePlatform
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorRole   RoleType?
  action      String
  entityType  String
  entityId    String
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  createdAt   DateTime  @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Dispute {
  id               String          @id @default(uuid())
  disputeNumber    String          @unique
  raisedByUserId   String
  category         DisputeCategory
  orderId          String?
  grnId            String?
  cashTransferId   String?
  description      String
  evidenceR2Keys   String[]
  status           DisputeStatus   @default(OPEN)
  resolvedByUserId String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  raisedBy     User              @relation("DisputeRaiser", fields: [raisedByUserId], references: [id])
  resolvedBy   User?             @relation("DisputeResolver", fields: [resolvedByUserId], references: [id])
  order        Order?            @relation(fields: [orderId], references: [id])
  grn          GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  cashTransfer CashTransfer?     @relation(fields: [cashTransferId], references: [id])

  @@index([raisedByUserId])
  @@index([status])
}
